{
  "linkedin": {
    "draft_path": "items",
    "max_chars": 200,
    "min_words": 6,
    "max_words": 70,
    "max_paragraphs": 4,
    "max_paragraph_words": 35,
    "max_blank_run": 1,
    "sentences_need_blank_line": true,
    "dashes": true,
    "links": true,
    "hashtags": true,
    "openers": [
      "spot on",
      "well said",
      "nailed it",
      "powerful",
      "absolutely",
      "totally agree",
      "awesome",
      "100%",
      "amazing",
      "so true",
      "nice one",
      "great post",
      "love this",
      "couldn't agree more",
      "insightful",
      "nice post",
      "thanks for sharing",
      "love it",
      "this resonates",
      "love that"
    ],
    "banned": [
      "orchestrates",
      "leverages",
      "streamlines",
      "seamless",
      "unlock",
      "game changer",
      "delve",
      "crucial",
      "elevate",
      "empower",
      "testament",
      "thrilled"
    ],
    "banned_any_ending": true,
    "pitches": [
      "dm me",
      "let's connect",
      "lets connect",
      "check out",
      "link in",
      "book a call",
      "booking link",
      "happy to help",
      "happy to chat",
      "happy to connect"
    ],
    "stock": [
      "hits different",
      "key takeaway",
      "let that sink in",
      "food for thought",
      "nobody talks about",
      "at the end of the day",
      "a must-read",
      "it's not just about",
      "here's the thing",
      "what nobody tells you",
      "great breakdown",
      "the whole story"
    ],
    "stock_regex": [
      "congrats.{0,40}(massive|huge|insane)",
      "(massive|huge|insane).{0,40}congrats"
    ],
    "thousands": true,
    "batch": {
      "shared_opening": true,
      "long_shape_share": 0.6,
      "long_shape_min_cards": 5,
      "long_shape_paragraphs": 2,
      "over_45_share": 0.3,
      "over_45_words": 45,
      "question_cap": "max(2, 0.4 * batch)",
      "laugh_share": 0.6,
      "laugh_min_cards": 5,
      "laugh_tokens": ["laugh", "lol", ":)", "tbh"],
      "first_person_min_share": 0.5,
      "first_person_min_cards": 5,
      "company_max_share": 0.1,
      "same_move": true,
      "six_word": true,
      "six_word_days": 14,
      "story_warn_share": 0.4
    },
    "review": [
      "One template on nearly every card: a grade, then a blank line, and then a receipt.",
      "Grading the post instead of speaking to the person who wrote it.",
      "The same few receipts, about 3 to 5, on repeat.",
      "A tidy mini post where their real comments are one line.",
      "Zero personal moments, or a story on every card.",
      "A slogan or a compliment where a take should be.",
      "Credentials nobody asked for: years, age, team size, a stack tour.",
      "A copywriter idiom where they would use a plain verb.",
      "A grade that points at the part or the one they would keep."
    ]
  },
  "x": {
    "draft_path": "picks",
    "max_chars": 200,
    "max_line_breaks": 1,
    "dashes": true,
    "links": true,
    "hashtags": true,
    "openers_at_line_start": [
      "spot on",
      "well said",
      "nice post",
      "awesome post",
      "amazing",
      "100%",
      "this",
      "so true",
      "love",
      "great"
    ],
    "banned": [
      "game changer",
      "delve",
      "crucial",
      "unlock",
      "seamless",
      "streamlines",
      "leverages",
      "orchestrates"
    ],
    "banned_any_ending": true,
    "stock_regex": [
      "nobody (talks|tells)",
      "what nobody",
      "whole story",
      "\\breal \\w+ is\\b",
      "actual work",
      "sink in",
      "hits different",
      "biggest change for me\\s*:",
      "what cut it\\s*:",
      ":\\s*(the )?(lesson|secret|trick|truth)\\b"
    ],
    "brags": ["we shipped", "our product", "our platform", "our tool"],
    "company_only_on_receipt": true,
    "company_max_share": 0.1,
    "review": [
      "Each taste block in the run is a pattern plus a why. A match fails even when this script does not know the pattern yet.",
      "Usually 70 to 160 characters, one or two sentences, and at most one question after a concrete line."
    ]
  }
}
